(ns glassworks.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  ASTM C158 three-point flexural bend-test simulation
  (`glassworks.robotics/simulate-flexural-strength-test`) over a fixed
  sweep and print ONE EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2310/SOUL.md)
  reads every tick. Every number is derived from a time-stepped
  trajectory, never typed in. Output schema `itonami.physical-ai.probe.v1`
  (see cloud-itonami-isic-2013's probe for the shared contract).

  `:count` is an evidence floor: the bot treats 0 as \"could not
  measure\", never as \"nothing out of tolerance\". Exit 0 when every run
  produced numbers, 2 when any run did not."
  (:require [glassworks.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep
  "Bend-test configurations swept each tick. The first three are the
  demo batches' own recorded configurations (`glassworks.store`:
  4.0 mm / 42.7 kg and 5.0 mm / 18.75 kg automotive-tempered, 0.7 mm /
  5.3 kg cover glass); the rest bracket the 4.0 mm tempered fixture in
  loading-pin mass so a solver change shows as a change in slope."
  [{:pin-mass-kg 42.7  :thickness-mm 4.0 :band :automotive-tempered}
   {:pin-mass-kg 18.75 :thickness-mm 5.0 :band :automotive-tempered}
   {:pin-mass-kg 5.3   :thickness-mm 0.7 :band :cover-glass}
   {:pin-mass-kg 10.0  :thickness-mm 4.0 :band :automotive-tempered}
   {:pin-mass-kg 20.0  :thickness-mm 4.0 :band :automotive-tempered}
   {:pin-mass-kg 30.0  :thickness-mm 4.0 :band :automotive-tempered}
   {:pin-mass-kg 60.0  :thickness-mm 4.0 :band :automotive-tempered}])

(defn- batch-for [{:keys [pin-mass-kg thickness-mm band]}]
  (let [{:keys [min max]} (get robotics/flexural-strength-band-mpa band)]
    {:flexural-test-pin-mass-kg pin-mass-kg
     :panel-thickness-actual-mm thickness-mm
     :flexural-strength-min-mpa min
     :flexural-strength-max-mpa max}))

(defn- run-one [input]
  (let [batch (batch-for input)
        t (robotics/flexural-telemetry-for batch)]
    {:input input
     :quantities (assoc t :peak-decel-mps2
                        (/ (:sim-peak-flexural-force-n t) (:pin-mass-kg input)))
     :out-of-tolerance? (boolean (robotics/flexural-stress-out-of-tolerance? (merge batch t)))}))

(defn- stress-at [pin-mass-kg thickness-mm]
  (:sim-peak-flexural-stress-mpa
   (robotics/flexural-telemetry-for {:flexural-test-pin-mass-kg pin-mass-kg
                                     :panel-thickness-actual-mm thickness-mm})))

(defn- bisect
  "Boundary of monotone predicate `ok?` between `lo` (not ok) and `hi`
  (ok). nil when the bracket does not straddle."
  [ok? lo hi iters]
  (when (and (not (ok? lo)) (ok? hi))
    (loop [lo lo hi hi i 0]
      (if (>= i iters)
        hi
        (let [mid (/ (+ lo hi) 2.0)]
          (if (ok? mid) (recur lo mid (inc i)) (recur mid hi (inc i))))))))

(defn min-passing-pin-mass-kg
  "Smallest loading-pin mass whose simulated peak flexural stress on a
  `thickness-mm` panel reaches the automotive-tempered band floor, by
  bisection over the REAL simulation (stress is monotone in pin mass).
  nil when the bracket does not straddle the floor."
  ([] (min-passing-pin-mass-kg 4.0 0.01 200.0 40))
  ([thickness-mm lo hi iters]
   (let [floor (get-in robotics/flexural-strength-band-mpa [:automotive-tempered :min])]
     (bisect #(>= (stress-at % thickness-mm) floor) lo hi iters))))

(defn max-passing-thickness-mm
  "Largest panel thickness whose simulated peak stress under the 42.7 kg
  fixture pin still reaches the automotive-tempered floor (stress falls
  with thickness), by bisection over the REAL simulation. nil when the
  bracket does not straddle."
  ([] (max-passing-thickness-mm 42.7 1.0 20.0 40))
  ([pin-mass-kg lo hi iters]
   (let [floor (get-in robotics/flexural-strength-band-mpa [:automotive-tempered :min])
         ;; bisect wants not-ok at lo, ok at hi: flip the axis.
         b (bisect #(>= (stress-at pin-mass-kg (- %)) floor) (- hi) (- lo) iters)]
     (when b (- b)))))

(defn probe []
  (let [runs (mapv run-one sweep)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-peak-flexural-stress-mpa])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2310"
     :procedure "ASTM C158 three-point flexural (modulus-of-rupture) bend test on a glass-panel coupon (robot flexural-test cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:tempered-floor-mpa (get-in robotics/flexural-strength-band-mpa [:automotive-tempered :min])
               :min-passing-pin-mass-kg-at-4mm (min-passing-pin-mass-kg)
               :max-passing-thickness-mm-at-42.7kg (max-passing-thickness-mm)}
     :count (count (filter numeric? runs))
     :expected (count sweep)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
